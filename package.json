{
  "name": "codeling",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A Duolingo-style app that teaches programming. Starts with Python.",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "node scripts/copy-pyodide.mjs && node scripts/build-content.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/build-content.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "precheck": "node scripts/build-content.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"scripts/*.test.mjs\"",
    "verify": "node scripts/build-content.mjs && node scripts/verify-in-pyodide.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "pyodide": "^314.0.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
